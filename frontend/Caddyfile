:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy central:8000
	}

	handle {
		root * /srv
		@shell not path /_app/immutable/*
		header @shell Cache-Control "no-cache"
		header /_app/immutable/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
